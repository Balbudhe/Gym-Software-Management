PORT=5000
CORS_ORIGIN=http://localhost:5173

# Prefer one Atlas URI (or set the two below separately)
MONGO_URI=

# Optional overrides:
# MONGODB_PLATFORM_URI=
# MONGODB_TENANT_BASE_URI=

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

ENCRYPTION_KEY=dev-encryption-key-must-be-32-chars

UPLOAD_DIR=uploads

FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Membership reminder SMS (use Fast2SMS or Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Membership reminder WhatsApp (Meta WhatsApp Cloud API, approved Utility templates)
# Template body variables: {{1}} member name, {{2}} gym name, {{3}} expiry date
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_BEFORE_3=membership_expiry_3_days
WHATSAPP_TEMPLATE_BEFORE_2=membership_expiry_2_days
WHATSAPP_TEMPLATE_ON_EXPIRY=membership_expiry_today
WHATSAPP_TEMPLATE_EXPIRED=membership_expired
REMINDER_HOUR_IST=9
